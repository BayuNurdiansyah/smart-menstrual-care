APP_NAME="Smart Menstrual"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_menstrual
DB_USERNAME=root
DB_PASSWORD=

# ── Cache & Session (driver file = tanpa tabel tambahan) ─────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Queue ──────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=sync

# ── Mail (kirim OTP) ───────────────────────────────────────────────────────
# log = OTP ke storage/logs/laravel.log (lokal). Produksi: ganti ke smtp asli.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@smart-menstrual.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Sanctum ────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

# ── Vite / Frontend ────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
